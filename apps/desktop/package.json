{
  "name": "@omniforge/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "OmniForge RE for macOS (Tauri 2 shell + local engine sidecar)",
  "scripts": {
    "tauri": "tauri",
    "sidecar": "node scripts/build-sidecar.mjs",
    "icons": "node scripts/make-icons.mjs && tauri icon src-tauri/icons/source.png",
    "dev": "pnpm sidecar --host && tauri dev",
    "build": "pnpm sidecar && tauri build",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.9.0"
  }
}
