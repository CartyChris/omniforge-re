{
  "name": "omniforge-re",
  "private": true,
  "version": "0.1.0",
  "description": "OmniForge RE — universal reverse engineering & AI development studio",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @omniforge/web build",
    "dev": "pnpm --filter @omniforge/web dev",
    "test": "pnpm -r --filter ./packages/** test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @omniforge/web lint",
    "e2e": "pnpm --filter @omniforge/web e2e",
    "desktop:dev": "pnpm --filter @omniforge/desktop tauri dev",
    "desktop:build": "pnpm --filter @omniforge/desktop tauri build"
  },
  "devDependencies": {
    "spdx-expression-parse": "^5.0.0"
  }
}
